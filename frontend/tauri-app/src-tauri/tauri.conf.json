{
  "$schema": "https://tauri.app",
  "productName": "マクロファクター-",
  "version": "1.1.0",
  "identifier": "com.junya.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build --prefix ..",
    "frontendDist": "../../out"
  },
  "app": {
    "windows": [
      {
        "title": "マクロファクター",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}